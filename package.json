{
    "name": "edge-ml",
    "version": "4.0.1",
    "description": "JavaScript library for edge-ml (https://github.com/edge-ml): collect data, train models and run them in the browser or Node.js",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "browser": {
        "dist/index.js": "dist/index.browser.js",
        "dist/index.mjs": "dist/index.browser.esm.js"
    },
    "unpkg": "dist/index.browser.js",
    "jsdelivr": "dist/index.browser.js",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "browser": {
                "import": "./dist/index.browser.esm.js",
                "default": "./dist/index.browser.js"
            },
            "import": "./dist/index.mjs",
            "default": "./dist/index.js"
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "types": "index.d.ts",
    "files": [
        "dist",
        "index.d.ts",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "rollup -c",
        "test": "jest --coverage",
        "test:browser": "node scripts/check-browser-bundle.js",
        "prepare": "husky install",
        "prepublishOnly": "npm run build && npm test && npm run test:browser",
        "test:integration": "jest --testPathIgnorePatterns /node_modules/ /fixtures/ --testMatch '**/__tests__/*integration.test.js'"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/edge-ml/javascript.git"
    },
    "keywords": [
        "edge-ml",
        "machine-learning",
        "onnx",
        "sensors",
        "time-series"
    ],
    "peerDependencies": {
        "onnxruntime-node": ">=1.17",
        "onnxruntime-web": ">=1.17"
    },
    "peerDependenciesMeta": {
        "onnxruntime-node": {
            "optional": true
        },
        "onnxruntime-web": {
            "optional": true
        }
    },
    "devDependencies": {
        "@rollup/plugin-alias": "^5.1.1",
        "axios": "^1.7.0",
        "husky": "^7.0.4",
        "jest": "^29.7.0",
        "onnxruntime-node": "^1.30.0",
        "onnxruntime-web": "^1.30.0",
        "rollup": "^4.0.0"
    },
    "jest": {
        "testEnvironment": "./jest.environment.js",
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/fixtures/",
            "integration\\.test\\.js$"
        ]
    }
}
